<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Android shell trusts only this computer's generated DSH CA. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/dsh_mobile_local_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
